{
  "name": "take-two",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "npm run runtime:prepare",
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src shared worker tests scripts docs memory-bank public/scenes/README.md ai/README.md *.ts *.js *.json *.jsonc *.md index.html",
    "format:check": "prettier --check src shared worker tests scripts docs memory-bank public/scenes/README.md ai/README.md *.ts *.js *.json *.jsonc *.md index.html",
    "test": "vitest run && npm run test:worker",
    "test:dev-server": "node scripts/check-dev-server.mjs",
    "test:dev-lifecycle": "node scripts/check-dev-lifecycle.mjs",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:render": "playwright test --config playwright.render.config.ts",
    "prebuild": "npm run runtime:prepare",
    "build": "npm run typecheck && vite build && npm run worker:build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "worker:dev": "wrangler dev --config wrangler.dev.jsonc --local",
    "worker:build": "wrangler deploy --dry-run --outdir .worker-build",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "runtime:verify": "node scripts/prepare-runtime.mjs --verify-only",
    "production:audit": "node scripts/audit-dist.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:production:render": "playwright test --config playwright.production-render.config.ts",
    "test:compat": "playwright test --config playwright.compat.config.ts",
    "deploy:cloudflare": "npm run build && npm run production:audit && wrangler deploy",
    "smoke:cloudflare": "node scripts/smoke-deployment.mjs",
    "ai:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-setup.ps1",
    "ai:setup:cuda": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-setup.ps1 -Cuda",
    "ai:models": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-models.ps1",
    "ai:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-dev.ps1",
    "ai:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-test.ps1",
    "ai:separation:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-separation-setup.ps1",
    "ai:separation:setup:cuda": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-separation-setup.ps1 -Cuda",
    "ai:separation:models": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-separation-models.ps1",
    "ai:separation:fallback-model": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-separation-fallback-model.ps1",
    "ai:separation:evaluate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-separation-evaluate.ps1",
    "ai:separation:evaluate:cpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-separation-evaluate.ps1 -Device cpu",
    "ai:separation:evaluate:fallback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-separation-evaluate-fallback.ps1",
    "ai:separation:evaluate:fallback:cpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-separation-evaluate-fallback.ps1 -Device cpu -Output local-test-media\\separation-eval\\clip1-speaker-regression-cdx23-cpu"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    }
  }
}
