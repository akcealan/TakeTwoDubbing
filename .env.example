# Optional public Worker origin, e.g. http://localhost:8787.
# Leave unset for Vite's /api proxy to local Wrangler on port 8787.
# For separate frontend hosting, set this before building and add the frontend
# origin to ALLOWED_ORIGINS in wrangler.jsonc before deployment.
# VITE_API_BASE_URL=
# VITE_ values are public. Never put Cloudflare tokens or R2 credentials here.
# Worker settings ALLOWED_ORIGINS and ROOM_TTL_MS live in wrangler.jsonc.
# Local Worker development needs no Cloudflare account or secrets.

# Optional local AI companion. The default is http://127.0.0.1:8765.
# This is a public browser setting; never put HF_TOKEN or any secret in VITE_ variables.
# VITE_AI_COMPANION_URL=http://127.0.0.1:8765

# Local AI process only (set in the terminal that starts `npm run ai:dev`).
# Add the exact future https://<worker>.<account>.workers.dev origin after deployment.
# TAKETWO_AI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# TAKETWO_AI_HOST=127.0.0.1
# HF_TOKEN is a local download-time secret. Never place its value in this file or VITE_ variables.
